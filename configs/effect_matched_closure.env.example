# Provider credentials stay local and must never be committed with values.
STATE_BENCH_AGENT_BASE_URL=
STATE_BENCH_AGENT_API_KEY=
STATE_BENCH_AGENT_MODEL=gpt-5.4
STATE_BENCH_AGENT_MAX_TOKENS=4096
STATE_BENCH_AGENT_TIMEOUT_SECONDS=120
STATE_BENCH_AGENT_MAX_RETRIES=6

# Frozen archived PWM.
STATE_BENCH_MEMORY_PATH=artifacts/statebench_cross_domain_pwm/memory/process_workflows.json
STATE_BENCH_MEMORY_MODE=hybrid

# Effect-matched closure contracts.
STATE_BENCH_CLOSURE_CONTRACT_PATH=artifacts/effect_matched_closure_memory/memory/closure_contracts.json
STATE_BENCH_CLOSURE_MODE=enforce
STATE_BENCH_CLOSURE_TOP_K=5
STATE_BENCH_CLOSURE_RELATIVE_THRESHOLD=0.32
STATE_BENCH_CLOSURE_MINIMUM_SCORE=0.25
