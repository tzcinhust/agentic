# Fill these two provider values locally. Never commit credentials.
STATE_BENCH_AGENT_BASE_URL=
STATE_BENCH_AGENT_API_KEY=
STATE_BENCH_AGENT_MODEL=gpt-5.4
STATE_BENCH_AGENT_MAX_TOKENS=4096
STATE_BENCH_AGENT_TIMEOUT_SECONDS=120
STATE_BENCH_AGENT_MAX_RETRIES=0

# Locked simulator/judge credentials. The runner rewrites the evaluator
# endpoint to its localhost relay, but requires the upstream key/model here so
# no stale provider settings can be inherited from the shell.
STATE_BENCH_EVAL_API_KEY=
STATE_BENCH_EVAL_ENDPOINT=https://your-openai-compatible-endpoint/v1
STATE_BENCH_EVAL_DEPLOYMENTS=gpt-5.4

STATE_BENCH_MEMORY_PATH=artifacts/statebench_cross_domain_pwm/memory/process_workflows.json
STATE_BENCH_MEMORY_MODE=hybrid

# Selective Decision-Aware PWM sidecar.  `shadow` records choices while
# returning the exact parent PWM result; `enforce` enables the promoted domains.
STATE_BENCH_WORKFLOW_ROUTER_PATH=artifacts/statebench_cross_domain_pwm/memory/workflow_router_v2.json
STATE_BENCH_WORKFLOW_ROUTER_MODE=enforce
# A=selector only, B=selector+typed packing, C=full State-Q/FlowSwitch stack.
STATE_BENCH_WORKFLOW_ROUTER_STAGE=C

# Shared relay settings.  Point both the custom agent and the locked evaluator
# at tools/eval_shim.py so their combined traffic stays below the provider RPM.
SHIM_UPSTREAM=https://your-openai-compatible-endpoint/v1
SHIM_PORT=8765
SHIM_RPM=45
SHIM_BURST=5
SHIM_BURST_WINDOW=1.0
SHIM_ATTEMPTS=5
