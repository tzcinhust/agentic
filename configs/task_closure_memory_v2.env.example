# Provider values stay local. Never commit credentials.
STATE_BENCH_AGENT_BASE_URL=
STATE_BENCH_AGENT_API_KEY=
STATE_BENCH_AGENT_MODEL=gpt-5.4
STATE_BENCH_AGENT_MAX_TOKENS=4096
STATE_BENCH_AGENT_TIMEOUT_SECONDS=120
STATE_BENCH_AGENT_MAX_RETRIES=6

# Frozen Procedure Workflow Memory (top-k remains 3 in the agent).
STATE_BENCH_MEMORY_PATH=artifacts/statebench_cross_domain_pwm/memory/process_workflows.json
STATE_BENCH_MEMORY_MODE=hybrid

# Independent Task-Closure Memory v2.
STATE_BENCH_COMPLETION_MODE=full
STATE_BENCH_COMPLETION_MEMORY_PATH=artifacts/task_closure_memory_v2/memory/completion_templates.json
STATE_BENCH_COMPLETION_TOP_K=8
