{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://state-bench.local/schemas/workflow_router_v2.schema.json",
  "title": "Selective Decision-Aware Process Workflow Memory Sidecar",
  "description": "Train-only, deterministic router sidecar. It contains no task requirements, test tasks, test outputs, or user conversation text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method",
    "source_memory_sha256",
    "provenance",
    "splits",
    "defaults",
    "domain_configs",
    "cards",
    "cv_report"
  ],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "method": { "const": "selective-decision-aware-process-workflow-memory" },
    "source_memory_sha256": { "$ref": "#/$defs/sha256" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shopping_assistant", "travel", "customer_support"],
      "properties": {
        "shopping_assistant": { "$ref": "#/$defs/split" },
        "travel": { "$ref": "#/$defs/split" },
        "customer_support": { "$ref": "#/$defs/split" }
      }
    },
    "defaults": { "$ref": "#/$defs/domainParameters" },
    "domain_configs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shopping_assistant", "travel", "customer_support"],
      "properties": {
        "shopping_assistant": { "$ref": "#/$defs/domainConfig" },
        "travel": { "$ref": "#/$defs/domainConfig" },
        "customer_support": { "$ref": "#/$defs/domainConfig" }
      }
    },
    "cards": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/card" }
    },
    "cv_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shopping_assistant", "travel", "customer_support"],
      "properties": {
        "shopping_assistant": { "$ref": "#/$defs/cvReport" },
        "travel": { "$ref": "#/$defs/cvReport" },
        "customer_support": { "$ref": "#/$defs/cvReport" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utilityAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trajectories", "scored_trajectories", "coverage", "utility_source", "fallback"],
      "properties": {
        "trajectories": { "type": "integer", "minimum": 0 },
        "scored_trajectories": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "utility_source": { "enum": ["unavailable", "embedded_trajectory_scores"] },
        "fallback": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_inputs",
        "split_metadata_input",
        "excluded_sources",
        "train_manifest_sha256",
        "train_inventory_sha256",
        "read_content_manifest_sha256",
        "train_file_count",
        "memory_sha256",
        "dev_manifest_sha256",
        "builder_sha256",
        "split_seed",
        "cv_seed",
        "memory_training_split",
        "memory_trajectory_counts",
        "lockbox_independent",
        "source_task_overlap",
        "utility_availability",
        "api_calls"
      ],
      "properties": {
        "learning_inputs": {
          "type": "array",
          "prefixItems": [
            { "const": "datasets/train_task_trajectories/<domain>/*.json" },
            { "const": "v1 process_workflows.json" }
          ],
          "items": false
        },
        "split_metadata_input": { "type": "string" },
        "excluded_sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "train_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "train_inventory_sha256": { "$ref": "#/$defs/sha256" },
        "read_content_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "train_file_count": { "enum": [240, 300] },
        "memory_sha256": { "$ref": "#/$defs/sha256" },
        "dev_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "builder_sha256": { "$ref": "#/$defs/sha256" },
        "split_seed": { "type": "string" },
        "cv_seed": { "type": "string" },
        "memory_training_split": { "enum": ["all", "optimizer"] },
        "memory_trajectory_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shopping_assistant", "travel", "customer_support"],
          "properties": {
            "shopping_assistant": { "enum": [80, 100] },
            "travel": { "enum": [80, 100] },
            "customer_support": { "enum": [80, 100] }
          }
        },
        "lockbox_independent": { "type": "boolean" },
        "source_task_overlap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shopping_assistant", "travel", "customer_support"],
          "properties": {
            "shopping_assistant": { "$ref": "#/$defs/heldoutOverlap" },
            "travel": { "$ref": "#/$defs/heldoutOverlap" },
            "customer_support": { "$ref": "#/$defs/heldoutOverlap" }
          }
        },
        "utility_availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shopping_assistant", "travel", "customer_support"],
          "properties": {
            "shopping_assistant": { "$ref": "#/$defs/utilityAvailability" },
            "travel": { "$ref": "#/$defs/utilityAvailability" },
            "customer_support": { "$ref": "#/$defs/utilityAvailability" }
          }
        },
        "api_calls": { "const": 0 }
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "lockbox", "optimizer"],
      "properties": {
        "dev": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
        "lockbox": { "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": { "type": "string" } },
        "optimizer": { "type": "array", "minItems": 80, "maxItems": 80, "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "heldoutOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dev", "lockbox"],
      "properties": {
        "dev": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "lockbox": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "utility", "risk", "trace", "mmr"],
      "properties": {
        "field": { "enum": [0.25, 0.5, 1.0] },
        "utility": { "enum": [0.0, 0.25, 0.5] },
        "risk": { "enum": [0.25, 0.5, 1.0] },
        "trace": { "enum": [0.0, 0.25] },
        "mmr": { "enum": [0.1, 0.2, 0.3] }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "near_tie",
        "candidate_pool",
        "max_cards",
        "default_cards",
        "min_relevance",
        "min_secondary_score",
        "secondary_relative_score",
        "same_family_limit",
        "duplicate_jaccard",
        "utility_cap",
        "min_utility_exposures",
        "stickiness"
      ],
      "properties": {
        "near_tie": { "enum": [0.5, 1.0, 2.0] },
        "candidate_pool": { "type": "integer", "minimum": 1 },
        "max_cards": { "type": "integer", "minimum": 0, "maximum": 3 },
        "default_cards": { "type": "integer", "minimum": 0, "maximum": 3 },
        "min_relevance": { "type": "number" },
        "min_secondary_score": { "type": "number" },
        "secondary_relative_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "same_family_limit": { "type": "integer", "minimum": 1, "maximum": 3 },
        "duplicate_jaccard": { "type": "number", "minimum": 0, "maximum": 1 },
        "utility_cap": { "type": "number", "minimum": 0 },
        "min_utility_exposures": { "type": "integer", "minimum": 1 },
        "stickiness": { "type": "number", "minimum": 0 }
      }
    },
    "domainParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["weights", "thresholds"],
      "properties": {
        "weights": { "$ref": "#/$defs/weights" },
        "thresholds": { "$ref": "#/$defs/thresholds" }
      }
    },
    "domainConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["promoted", "weights", "thresholds"],
      "properties": {
        "promoted": { "type": "boolean" },
        "weights": { "$ref": "#/$defs/weights" },
        "thresholds": { "$ref": "#/$defs/thresholds" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "required_reads",
        "authorized_writes",
        "verification_rules",
        "decision_rules",
        "required_disclosures",
        "prohibitions",
        "scope"
      ],
      "properties": {
        "trigger": { "type": "string", "minLength": 1 },
        "required_reads": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "authorized_writes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verification_rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "decision_rules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_disclosures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "prohibitions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["card_id", "domain", "family", "title"],
          "properties": {
            "card_id": { "type": "string" },
            "domain": { "enum": ["shopping_assistant", "travel", "customer_support"] },
            "family": { "type": "string" },
            "title": { "type": "string" }
          }
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid", "fallback_to_base_card", "reasons", "checks"],
      "properties": {
        "valid": { "type": "boolean" },
        "fallback_to_base_card": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_binding", "write_subset", "disclosure_coverage", "prohibition_coverage", "length_bound", "variable_binding"],
          "properties": {
            "tool_binding": { "enum": ["passed", "failed"] },
            "write_subset": { "enum": ["passed", "failed"] },
            "disclosure_coverage": { "enum": ["passed", "failed"] },
            "prohibition_coverage": { "enum": ["passed", "failed"] },
            "length_bound": { "enum": ["passed", "failed"] },
            "variable_binding": { "type": "string" }
          }
        }
      }
    },
    "utility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utility_source",
        "neutral_prior",
        "domain_prior",
        "card_prior",
        "state_priors",
        "state_prior_support",
        "exposures",
        "scored_exposures",
        "coverage",
        "fallback"
      ],
      "properties": {
        "utility_source": { "enum": ["unavailable", "embedded_trajectory_scores"] },
        "neutral_prior": { "type": "number", "minimum": 0, "maximum": 1 },
        "domain_prior": { "type": "number", "minimum": 0, "maximum": 1 },
        "card_prior": { "type": "number", "minimum": 0, "maximum": 1 },
        "state_priors": {
          "description": "Canonical key: domain|family|tool1+tool2|phase.",
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "state_prior_support": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "exposures": { "type": "integer", "minimum": 0 },
        "scored_exposures": { "type": "integer", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "fallback": { "type": ["string", "null"] }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "family",
        "source_card_sha256",
        "contract",
        "compiler",
        "primary_text",
        "secondary_text",
        "packing",
        "utility"
      ],
      "properties": {
        "domain": { "enum": ["shopping_assistant", "travel", "customer_support"] },
        "family": { "type": "string" },
        "source_card_sha256": { "$ref": "#/$defs/sha256" },
        "contract": { "$ref": "#/$defs/contract" },
        "compiler": { "$ref": "#/$defs/compiler" },
        "primary_text": { "type": "string" },
        "secondary_text": { "type": "string" },
        "packing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_chars", "primary_chars", "secondary_chars", "primary_reduction", "secondary_reduction"],
          "properties": {
            "source_chars": { "type": "integer", "minimum": 0 },
            "primary_chars": { "type": "integer", "minimum": 0 },
            "secondary_chars": { "type": "integer", "minimum": 0 },
            "primary_reduction": { "type": "number" },
            "secondary_reduction": { "type": "number" }
          }
        },
        "utility": { "$ref": "#/$defs/utility" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "cvReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "seed", "grid_size", "evaluated_configs", "examples", "tasks", "objective", "selected_metrics", "fold_metrics", "feasibility_constraints", "tie_break"],
      "properties": {
        "method": { "type": "string" },
        "seed": { "type": "string" },
        "grid_size": { "const": 486 },
        "evaluated_configs": { "const": 486 },
        "examples": { "type": "integer", "minimum": 1 },
        "tasks": { "const": 80 },
        "objective": { "type": "string" },
        "selected_metrics": { "$ref": "#/$defs/metrics" },
        "fold_metrics": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/metrics" } },
        "feasibility_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hard_anchor_margin", "near_tie_grid", "runtime_invariant_memoization", "runtime_components"],
          "properties": {
            "hard_anchor_margin": { "const": 2.0 },
            "near_tie_grid": { "const": [0.5, 1.0, 2.0] },
            "runtime_invariant_memoization": { "const": true },
            "runtime_components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          }
        },
        "tie_break": { "type": "string" }
      }
    }
  }
}
