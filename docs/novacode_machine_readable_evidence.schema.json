{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tzcinhust/agentic/schemas/novacode-machine-readable-evidence-v1.json",
  "title": "Machine-readable NovaCode rate-card or invoice export",
  "oneOf": [
    { "$ref": "#/$defs/rate_card" },
    { "$ref": "#/$defs/invoice_export" }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decimal": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" }
      ]
    },
    "usage": {
      "type": "object",
      "description": "Full provider-billable relay usage, including retries and abandoned audited agent attempts.",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "output_tokens",
        "total_tokens"
      ],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "common": {
      "type": "object",
      "required": [
        "schema_version",
        "provider",
        "document_type",
        "model",
        "currency",
        "issued_at"
      ],
      "properties": {
        "schema_version": { "const": "novacode_machine_readable_evidence_v1" },
        "provider": { "const": "NovaCode" },
        "document_type": {
          "enum": ["provider_rate_card", "provider_invoice_export"]
        },
        "model": { "const": "gpt-5.4" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "issued_at": { "type": "string", "minLength": 1 }
      }
    },
    "rate_card": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "provider",
            "document_type",
            "model",
            "currency",
            "issued_at",
            "rates_per_million_tokens"
          ],
          "properties": {
            "schema_version": true,
            "provider": true,
            "document_type": { "const": "provider_rate_card" },
            "model": true,
            "currency": true,
            "issued_at": true,
            "rates_per_million_tokens": {
              "type": "object",
              "additionalProperties": false,
              "required": ["uncached_input", "cached_input", "output"],
              "properties": {
                "uncached_input": { "$ref": "#/$defs/decimal" },
                "cached_input": { "$ref": "#/$defs/decimal" },
                "output": { "$ref": "#/$defs/decimal" }
              }
            }
          }
        }
      ]
    },
    "invoice_export": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "provider",
            "document_type",
            "model",
            "currency",
            "issued_at",
            "invoice"
          ],
          "properties": {
            "schema_version": true,
            "provider": true,
            "document_type": { "const": "provider_invoice_export" },
            "model": true,
            "currency": true,
            "issued_at": true,
            "invoice": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "invoice_id_sha256",
                "billing_period_start",
                "billing_period_end",
                "billing_scope",
                "billable_usage",
                "amount"
              ],
              "properties": {
                "invoice_id_sha256": { "$ref": "#/$defs/sha256" },
                "billing_period_start": { "type": "string", "minLength": 1 },
                "billing_period_end": { "type": "string", "minLength": 1 },
                "billing_scope": {
                  "const": "official750_candidate_c_full_provider_traffic"
                },
                "billable_usage": { "$ref": "#/$defs/usage" },
                "amount": { "$ref": "#/$defs/decimal" }
              }
            }
          }
        }
      ]
    }
  }
}
